# Resolve AI API base URL, including /api/v1 (inlined into the browser bundle at build time).
# Required: the app throws at load if it is missing.
# Local backend: copy to .env.local (cp -n .env.example .env.local) and keep this line.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Hosted API: NEXT_PUBLIC_API_BASE_URL=https://resolve-ai-production-8093.up.railway.app/api/v1

# --- Workbench Google sign-in (Auth.js v5). Server-only: never prefix these with NEXT_PUBLIC_. ---
# Random secret that encrypts the session cookie. Generate with: npx auth secret
# (or: openssl rand -base64 33). Use a different value in production.
AUTH_SECRET=
# Google OAuth web client credentials. Keep these values in the server environment.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed for npm start (production build) outside Vercel: trust the request host.
# AUTH_TRUST_HOST=true
