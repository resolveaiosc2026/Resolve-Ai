# Copy to .env and adjust. Never commit .env.

# development | production
NODE_ENV=development

# API port (the Next.js frontend uses 3000)
PORT=4000

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# Neon Postgres, POOLED connection string (Dashboard -> Connect -> Pooled connection).
# Use sslmode=verify-full (Neon's default `require` triggers a pg deprecation warning).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
