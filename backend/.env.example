# Copy to .env and adjust. Never commit .env.

# development | production
NODE_ENV=development

# API port (the Next.js frontend uses 3000)
PORT=4000

# Comma-separated origins allowed to call the API from a browser (no trailing slash needed;
# one * per entry for preview URLs, e.g. https://resolve-ai-*.vercel.app)
CORS_ORIGIN=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# Neon Postgres, POOLED connection string (Dashboard -> Connect -> Pooled connection).
# Use sslmode=verify-full (Neon's default `require` triggers a pg deprecation warning).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Optional: OpenRouter key for AI reply classification. Leave empty to use the
# deterministic keyword fallback (the demo works fully without it).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_MS=8000

# Demo-only simulation routes (/simulation/*). Default: on outside production, off in production.
# Set ENABLE_SIMULATION=true on Railway for the hosted demo.
# ENABLE_SIMULATION=true

# Per-IP rate limits (AI 20/min, writes 120/min, reads 600/min). Set false only for load tests.
RATE_LIMIT_ENABLED=true
